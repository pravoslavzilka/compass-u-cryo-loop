root  := "Z:/compass-u-cryo-loop";
outd  := root + "/vm-inbox/pf_scen";
Modelica.Utilities.Files.createDirectory(outd);
st := outd + "/status.txt";
if Modelica.Utilities.Files.exist(st) then
  Modelica.Utilities.Files.remove(st);
end if;
clearlog();
Modelica.Utilities.Streams.print("RUNNING: load + translate", st);
openModel("C:/Program Files/Dymola 2024x Refresh 1/Modelica/Library/ThermalSystems 1.13.0/package.mo", mustRead=true);
openModel(root + "/dymola-thermal-systems/CoilLoopCompassU/package.mo", mustRead=true);
cd(outd);
ok := translateModel("CoilLoopCompassU.PF.PFCircuit(enableCoilIsolation=true, enableCirculatorPowerOptimization=false, enablePressureControl=true, enableOverCoolPrevention=true, enableOverCoolRecovery=true, PF1U(TInitial=92.485), PF1L(TInitial=112.404), PF2U(TInitial=83.202), PF2L(TInitial=88.449), PF3U(TInitial=86.384), PF3L(TInitial=98.882), PF4U(TInitial=80.762), PF4L(TInitial=81.834))");
savelog(outd + "/log.txt");
if not ok then
  Modelica.Utilities.Streams.print("FAIL: translation", st);
  Modelica.Utilities.Streams.print(getLastErrorLog(), outd + "/last_error.txt");
else
  Modelica.Utilities.Streams.print("RUNNING: simulate 1815 s", st);
  OutputCPUtime := true;
  simOk := simulateModel("CoilLoopCompassU.PF.PFCircuit(enableCoilIsolation=true, enableCirculatorPowerOptimization=false, enablePressureControl=true, enableOverCoolPrevention=true, enableOverCoolRecovery=true, PF1U(TInitial=92.485), PF1L(TInitial=112.404), PF2U(TInitial=83.202), PF2L(TInitial=88.449), PF3U(TInitial=86.384), PF3L(TInitial=98.882), PF4U(TInitial=80.762), PF4L(TInitial=81.834))", stopTime=1815, tolerance=1e-4,
                         resultFile=outd + "/result");
  savelog(outd + "/log.txt");
  if simOk then
    Modelica.Utilities.Streams.print("OK: simulated 1815 s", st);
  else
    Modelica.Utilities.Streams.print("FAIL: simulation", st);
    Modelica.Utilities.Streams.print(getLastErrorLog(), outd + "/last_error.txt");
  end if;
end if;
